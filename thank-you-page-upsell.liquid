<!--
  Hot Leathers Thank You Page Upsell
  SIMPLER ALTERNATIVE to Post-Purchase Extension

  Add this to: Settings > Checkout > Order status page > Additional scripts
  (Shopify Plus feature)
-->

{% if first_time_accessed %}
<div id="hl-thankyou-upsell">
  <style>
    .hl-upsell-container {
      background: #1a1a1a;
      border: 2px solid #ff6600;
      border-radius: 12px;
      padding: 30px;
      margin: 30px 0;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }

    .hl-upsell-header {
      text-align: center;
      margin-bottom: 25px;
    }

    .hl-upsell-icon {
      font-size: 48px;
      margin-bottom: 10px;
    }

    .hl-upsell-title {
      color: #fff;
      font-size: 24px;
      font-weight: bold;
      margin: 0 0 10px;
    }

    .hl-upsell-subtitle {
      color: #ccc;
      font-size: 16px;
      margin: 0;
    }

    .hl-discount-banner {
      background: #2a2a2a;
      border: 2px dashed #ff6600;
      border-radius: 8px;
      padding: 20px;
      text-align: center;
      margin: 20px 0;
    }

    .hl-discount-label {
      color: #999;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 8px;
    }

    .hl-discount-code {
      color: #ff6600;
      font-size: 28px;
      font-weight: bold;
      font-family: 'Courier New', monospace;
      margin: 10px 0;
      letter-spacing: 2px;
    }

    .hl-discount-value {
      color: #fff;
      font-size: 18px;
      margin-top: 5px;
    }

    .hl-products-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin: 25px 0;
    }

    .hl-product-card {
      background: #2a2a2a;
      border: 1px solid #333;
      border-radius: 8px;
      padding: 15px;
      text-align: center;
      transition: all 0.3s;
    }

    .hl-product-card:hover {
      border-color: #ff6600;
      transform: translateY(-2px);
    }

    .hl-product-image {
      width: 100%;
      height: 150px;
      object-fit: cover;
      border-radius: 6px;
      margin-bottom: 10px;
    }

    .hl-product-title {
      color: #fff;
      font-size: 16px;
      font-weight: bold;
      margin: 10px 0;
    }

    .hl-product-price {
      color: #ccc;
      font-size: 14px;
      margin: 5px 0;
    }

    .hl-product-price-original {
      text-decoration: line-through;
      color: #888;
    }

    .hl-product-price-discounted {
      color: #ff6600;
      font-size: 18px;
      font-weight: bold;
    }

    .hl-shop-button {
      background: linear-gradient(135deg, #ff6600 0%, #ff8833 100%);
      color: #fff;
      border: none;
      padding: 12px 30px;
      border-radius: 6px;
      font-size: 14px;
      font-weight: bold;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      margin-top: 10px;
      transition: all 0.3s;
      text-transform: uppercase;
    }

    .hl-shop-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(255, 102, 0, 0.4);
      color: #fff;
      text-decoration: none;
    }

    .hl-upsell-note {
      text-align: center;
      color: #888;
      font-size: 12px;
      margin-top: 20px;
      font-style: italic;
    }

    @media (max-width: 600px) {
      .hl-upsell-container {
        padding: 20px;
        margin: 20px 10px;
      }

      .hl-products-grid {
        grid-template-columns: 1fr;
      }

      .hl-upsell-title {
        font-size: 20px;
      }

      .hl-discount-code {
        font-size: 24px;
      }
    }
  </style>

  <div class="hl-upsell-container">
    <div class="hl-upsell-header">
      <div class="hl-upsell-icon">🏍️</div>
      <h2 class="hl-upsell-title">Complete Your Ride!</h2>
      <p class="hl-upsell-subtitle">Thank you for your order! Get 5% off your next purchase</p>
    </div>

    <div class="hl-discount-banner">
      <div class="hl-discount-label">EXCLUSIVE OFFER - USE CODE:</div>
      <div class="hl-discount-code">RIDE5</div>
      <div class="hl-discount-value">Save 5% on Your Next Order</div>
    </div>

    <div id="hl-recommended-products"></div>

    <p class="hl-upsell-note">*Cannot be combined with other discounts. Valid for 30 days.</p>
  </div>

  <script>
    (function() {
      // Get order details
      const order = {{ order | json }};
      const lineItems = {{ line_items | json }};

      console.log('Order:', order);
      console.log('Line items:', lineItems);

      // Determine what products to recommend based on purchase
      function getRecommendedProducts() {
        const purchased = lineItems.map(item => ({
          type: item.product_type || '',
          title: item.title || '',
          vendor: item.vendor || ''
        }));

        // Define your product recommendations
        // Replace these with actual product IDs and data from your store
        const recommendations = [];

        // Check what they bought
        const boughtJacket = purchased.some(p =>
          p.type.toLowerCase().includes('jacket') ||
          p.title.toLowerCase().includes('jacket')
        );

        const boughtGloves = purchased.some(p =>
          p.type.toLowerCase().includes('glove') ||
          p.title.toLowerCase().includes('glove')
        );

        const boughtHelmet = purchased.some(p =>
          p.type.toLowerCase().includes('helmet') ||
          p.title.toLowerCase().includes('helmet')
        );

        const boughtBoots = purchased.some(p =>
          p.type.toLowerCase().includes('boot') ||
          p.title.toLowerCase().includes('boot')
        );

        // Recommendation logic
        if (boughtJacket && !boughtGloves) {
          recommendations.push({
            handle: 'leather-gloves', // Replace with actual product handle
            title: 'Premium Leather Gloves',
            price: 49.99,
            image: '/path/to/gloves-image.jpg' // Replace with actual image
          });
        }

        if (boughtJacket && !boughtHelmet) {
          recommendations.push({
            handle: 'motorcycle-helmet',
            title: 'DOT Certified Helmet',
            price: 89.99,
            image: '/path/to/helmet-image.jpg'
          });
        }

        if (boughtGloves && !boughtJacket) {
          recommendations.push({
            handle: 'leather-jacket',
            title: 'Classic Leather Jacket',
            price: 199.99,
            image: '/path/to/jacket-image.jpg'
          });
        }

        if ((boughtJacket || boughtGloves) && !boughtBoots) {
          recommendations.push({
            handle: 'riding-boots',
            title: 'Waterproof Riding Boots',
            price: 129.99,
            image: '/path/to/boots-image.jpg'
          });
        }

        // Default recommendations if no matches
        if (recommendations.length === 0) {
          recommendations.push({
            handle: 'best-seller-1',
            title: 'Best Selling Item 1',
            price: 59.99,
            image: '/path/to/default-image.jpg'
          });
        }

        return recommendations.slice(0, 2); // Show max 2 products
      }

      // Render product recommendations
      function renderProducts() {
        const products = getRecommendedProducts();

        if (products.length === 0) {
          document.getElementById('hl-thankyou-upsell').style.display = 'none';
          return;
        }

        const container = document.getElementById('hl-recommended-products');
        const grid = document.createElement('div');
        grid.className = 'hl-products-grid';

        products.forEach(product => {
          const discountedPrice = (product.price * 0.95).toFixed(2);
          const savings = (product.price - discountedPrice).toFixed(2);

          const card = document.createElement('div');
          card.className = 'hl-product-card';
          card.innerHTML = `
            <img src="${product.image}" alt="${product.title}" class="hl-product-image" onerror="this.style.display='none'">
            <h3 class="hl-product-title">${product.title}</h3>
            <div class="hl-product-price">
              <div class="hl-product-price-original">$${product.price.toFixed(2)}</div>
              <div class="hl-product-price-discounted">$${discountedPrice}</div>
              <div style="color: #4CAF50; font-size: 12px; margin-top: 5px;">Save $${savings}</div>
            </div>
            <a href="/discount/RIDE5?redirect=/products/${product.handle}" class="hl-shop-button">
              Shop Now →
            </a>
          `;

          grid.appendChild(card);
        });

        container.appendChild(grid);
      }

      // Initialize
      renderProducts();

      // Track that upsell was shown
      try {
        if (typeof window.HotLeathersPersonalization !== 'undefined') {
          window.HotLeathersPersonalization.updateProfile({
            postPurchaseUpsellShown: true,
            lastOrderDate: new Date().toISOString()
          });
        }
      } catch (e) {
        console.log('Personalization tracking error:', e);
      }
    })();
  </script>
</div>
{% endif %}
